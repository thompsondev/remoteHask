{
  "name": "@remotehask/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types, enums, and API contracts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "require": "./dist/api/index.js",
      "import": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    },
    "./ws": {
      "types": "./dist/ws/index.d.ts",
      "require": "./dist/ws/index.js",
      "import": "./dist/ws/index.js",
      "default": "./dist/ws/index.js"
    },
    "./validators": {
      "types": "./dist/validators/index.d.ts",
      "require": "./dist/validators/index.js",
      "import": "./dist/validators/index.js",
      "default": "./dist/validators/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "clean": "rm -rf dist *.tsbuildinfo",
    "contracts:check": "pnpm build && node scripts/contract-check.cjs"
  },
  "dependencies": {
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@remotehask/shared-config": "workspace:*",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
