# E2E / integration tests — copy to .env.test (loaded by test/setup-env.ts)
# Requires running Postgres + Redis; run migrations and seed before `pnpm test:e2e`

NODE_ENV=test
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=error

DATABASE_URL=postgresql://remotehask:remotehask@localhost:5432/remotehask
DB_POOL_MAX=5
DB_LOGGING=false

REDIS_URL=redis://localhost:6379

JWT_SECRET=local-dev-jwt-secret-min-32-characters!!
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
REFRESH_COOKIE_NAME=rh_refresh

WS_PUBLIC_URL=http://localhost:4000
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TTL_SECONDS=45
PRESENCE_STALE_GRACE_SECONDS=30
