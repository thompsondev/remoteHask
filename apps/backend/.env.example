# remoteHask backend — copy to .env (or .env.local) before `pnpm dev`
# Validated by apps/backend/src/config/env.schema.ts

# --- Server ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- PostgreSQL (required) ---
DATABASE_URL=postgresql://remotehask:remotehask@localhost:5432/remotehask
DB_POOL_MAX=20
DB_LOGGING=false

# --- Redis (required) ---
REDIS_URL=redis://localhost:6379

# --- JWT (required in production; min 32 chars) ---
JWT_SECRET=local-dev-jwt-secret-min-32-characters!!
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
REFRESH_COOKIE_NAME=rh_refresh

# --- WebSocket / presence (monolith dev: same host as REST) ---
WS_PUBLIC_URL=http://localhost:4000
# GATEWAY_INSTANCE_ID=gw-local-1
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TTL_SECONDS=45
PRESENCE_STALE_GRACE_SECONDS=30

# --- Dev: agent simulator (`pnpm --filter @remotehask/backend agent:sim`) ---
# ENROLLMENT_TOKEN=enr_xxx
# API_URL=http://localhost:4000/api/v1
# WS_URL=http://localhost:4000
# HOSTNAME=sim-workstation.local
# OS_USER=sim-user
