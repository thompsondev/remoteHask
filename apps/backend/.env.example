NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL (required)
DATABASE_URL=postgresql://remotehask:remotehask@localhost:5432/remotehask
DB_POOL_MAX=20
DB_LOGGING=false

# Redis (required)
REDIS_URL=redis://localhost:6379

# JWT (required — use a long random string in production)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
REFRESH_COOKIE_NAME=rh_refresh

# WebSocket (same host as API for monolith dev)
WS_PUBLIC_URL=http://localhost:4000
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TTL_SECONDS=45
