{
  "name": "@remotehask/backend",
  "version": "0.0.0",
  "private": true,
  "description": "remoteHask NestJS API and control plane",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "openapi:generate": "ts-node --project tsconfig.json scripts/generate-openapi.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "db:migrate:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "db:migrate:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "db:seed": "ts-node --project tsconfig.json src/database/seeds/run-seed.ts",
    "agent:sim": "ts-node --project tsconfig.json scripts/agent-simulator.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.2",
    "@nestjs/platform-express": "^11.1.2",
    "@nestjs/platform-socket.io": "^11.1.2",
    "@nestjs/websockets": "^11.1.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "@remotehask/shared-types": "workspace:*",
    "@remotehask/shared-utils": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.6.1",
    "nest-winston": "^1.10.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.5.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.24",
    "typeorm-naming-strategies": "^4.1.0",
    "winston": "^3.17.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.2",
    "@remotehask/shared-config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "supertest": "^7.1.1",
    "@types/supertest": "^6.0.3"
  }
}
