# remoteHask frontend — copy to .env.local for `pnpm dev`
# NEXT_PUBLIC_* are embedded at build time; restart dev server after changes.

# REST API (NestJS global prefix included)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Socket.IO console namespace (`/console` appended in code)
NEXT_PUBLIC_WS_URL=http://localhost:4000
